# Kconfig fragment merged on top of Microsoft's config-wsl-arm64.
# Everything is built-in (=y): a custom WSL kernel does not get the
# stock modules VHD, so anything left as =m would be unavailable.

CONFIG_LOCALVERSION="-waydroid"

# BTF generation (pahole) needs >3.5 GB RAM and gets OOM-killed under the
# default WSL memory limit. Only eBPF tooling uses it; Waydroid doesn't.
# CONFIG_DEBUG_INFO_BTF is not set

# Android IPC (the only thing Waydroid strictly needs that WSL lacks)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Already =y upstream, pinned so a future base config can't drop them
CONFIG_PSI=y
CONFIG_CGROUP_DEVICE=y
CONFIG_VETH=y
CONFIG_MEMFD_CREATE=y

# LXC bridge + NAT used by waydroid-net.sh. It prefers iptables-legacy and
# also adds a mangle/CHECKSUM rule for DHCP, so the legacy tables must exist.
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
